# Math Farm Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=mathfarm
DB_PASSWORD=your_secure_password_here
DB_NAME=mathfarm

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_with_at_least_256_bits_of_entropy
JWT_EXPIRES_IN=24h

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Forum Configuration
FORUM_POSTS_PER_PAGE=20
FORUM_THREADS_PER_PAGE=25
FORUM_MAX_POST_LENGTH=10000
FORUM_MAX_THREAD_TITLE_LENGTH=500

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_AVATAR_SIZE_MB=1
ALLOWED_AVATAR_FORMATS=svg,png,jpg,jpeg

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_CORS=false

# Development Settings
ENABLE_DEBUG_LOGGING=false
ENABLE_SQL_LOGGING=false