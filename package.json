{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0 <19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "set NODE_ENV=development && tsx server/index.ts",
    "build": "vite build",
    "build:analyze": "node scripts/build-analysis.js",
    "build:server": "tsc --project server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "start": "set NODE_ENV=production && node dist/index.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:navigation": "tsx client/src/test/run-navigation-tests.ts",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "docs:generate": "typedoc",
    "docs:serve": "npx http-server docs/api -p 8080 -o",
    "docs:build": "npm run docs:generate",
    "docs:clean": "rimraf docs/api",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:serve": "npx http-server storybook-static -p 6007 -o",
    "db:init": "tsx server/database/init.ts",
    "db:seed": "tsx server/database/forum-seed-data.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.20",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^4.36.1",
    "@types/ws": "^8.5.10",
    "bcrypt": "^5.1.1",
    "better-react-mathjax": "^2.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.0.8",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "isomorphic-dompurify": "^2.6.0",
    "jsonwebtoken": "^9.0.2",
    "jsxgraph": "^1.8.0",
    "lucide-react": "^0.300.0",
    "mathjax": "^3.2.2",
    "mathjs": "^12.4.0",
    "mysql2": "^3.6.5",
    "nerdamer": "^1.1.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@eslint/js": "^8.57.0",
    "@replit/vite-plugin-cartographer": "^0.3.0",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@storybook/addon-a11y": "^7.6.17",
    "@storybook/addon-docs": "^7.6.17",
    "@storybook/addon-onboarding": "^1.0.10",
    "@storybook/addon-vitest": "^1.0.1",
    "@storybook/react-vite": "^7.6.17",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.0.0-alpha.15",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcrypt": "^5.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mathjs": "^9.4.2",
    "@types/node": "^18.19.31",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^0.8.0",
    "husky": "^9.0.11",
    "jest-axe": "^8.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "playwright": "^1.43.1",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^7.6.17",
    "supertest": "^6.3.4",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.7.2",
    "typedoc": "^0.25.13",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.7.1",
    "vite": "^5.2.10",
    "vitest": "^1.6.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'npm run type-check'"
    ]
  }
}
